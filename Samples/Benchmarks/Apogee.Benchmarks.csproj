<Project Sdk="Microsoft.NET.Sdk">
  <!-- Measurements, not tests: `./build.sh bench [filter]`. BenchmarkDotNet (MIT) is used here only and never ships with a game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AnalysisMode>Default</AnalysisMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Source/Apogee.Core/Apogee.Core.csproj" />
  </ItemGroup>
</Project>
