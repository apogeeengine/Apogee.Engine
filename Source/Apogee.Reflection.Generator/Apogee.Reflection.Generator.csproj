<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <!-- A Roslyn component runs inside the compiler: netstandard2.0, never AOT. Its own code is not held to the engine's analyzer set. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- dotnet publish -p:PublishAot=true reaches the projects the runtime references, but a compiler component is never AOT. -->
    <PublishAot>false</PublishAot>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);RS1035;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Apogee.Reflection.Tests" />
  </ItemGroup>
</Project>
