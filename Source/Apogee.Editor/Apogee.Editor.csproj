<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ImGui editor: a CoreCLR program (it is a tool, not shipped in a game, so it is never published with NativeAOT). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The editor's own checks: ImGui code passes pointers and CBool around, which the analyzers do not like in a tool. -->
    <NoWarn>$(NoWarn);CA1305</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Apogee.Core/Apogee.Core.csproj" />
    <ProjectReference Include="../Apogee.Interop/Apogee.Interop.csproj" />
    <ProjectReference Include="../Apogee.Ecs/Apogee.Ecs.csproj" />
    <ProjectReference Include="../Apogee.Platform/Apogee.Platform.csproj" />
    <ProjectReference Include="../Apogee.Input/Apogee.Input.csproj" />
    <ProjectReference Include="../Apogee.Physics/Apogee.Physics.csproj" />
    <ProjectReference Include="../Apogee.Content/Apogee.Content.csproj" />
    <ProjectReference Include="../Apogee.Graphics/Apogee.Graphics.csproj" />
    <ProjectReference Include="../Apogee.Rendering/Apogee.Rendering.csproj" />
    <ProjectReference Include="../Apogee.DevTools/Apogee.DevTools.csproj" />
    <ProjectReference Include="../Apogee.UI/Apogee.UI.csproj" />
    <ProjectReference Include="../Apogee.Reflection/Apogee.Reflection.csproj" />
    <ProjectReference Include="../Apogee.Scripting/Apogee.Scripting.csproj" />
    <ProjectReference Include="../Apogee.Host/Apogee.Host.csproj" />
    <ProjectReference Include="../Apogee.Reflection.Generator/Apogee.Reflection.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="../Apogee.Native.Sdl/Apogee.Native.Sdl.csproj" />
    <ProjectReference Include="../Apogee.Native.Flecs/Apogee.Native.Flecs.csproj" />
    <ProjectReference Include="../Apogee.Native.CImGui/Apogee.Native.CImGui.csproj" />
    <ProjectReference Include="../Apogee.Native.ImGuizmo/Apogee.Native.ImGuizmo.csproj" />
    <ProjectReference Include="../Apogee.Native.ImNodes/Apogee.Native.ImNodes.csproj" />
    <ProjectReference Include="../Apogee.Native.ImPlot/Apogee.Native.ImPlot.csproj" />
    <ProjectReference Include="../Apogee.Native.Vulkan/Apogee.Native.Vulkan.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Apogee.Editor.Tests" />
  </ItemGroup>
  <Import Project="../../ThirdParty/NativeLibraries.props" />
</Project>
