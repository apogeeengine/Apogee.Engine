<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- CA1720/CA1716: names follow what they hold (Entity, Phase.OnUpdate…). -->
    <NoWarn>$(NoWarn);CA1720;CA1716</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Apogee.Core/Apogee.Core.csproj" />
    <!-- Scenes are documents of assets: ContentException, and later XmlNode and AssetDatabase for scene files. -->
    <ProjectReference Include="../Apogee.Content/Apogee.Content.csproj" />
    <ProjectReference Include="../Apogee.Interop/Apogee.Interop.csproj" />
    <ProjectReference Include="../Apogee.Reflection/Apogee.Reflection.csproj" />
    <ProjectReference Include="../Apogee.Native.Flecs/Apogee.Native.Flecs.csproj" />
    <ProjectReference Include="../Apogee.Reflection.Generator/Apogee.Reflection.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot" />
  </ItemGroup>
  <ItemGroup>
    <!-- The schema of a .ascene file. -->
    <EmbeddedResource Include="Scene/scene.xsd" LogicalName="Scene/scene.xsd" />
    <!-- The schema of a .aprefab file. -->
    <EmbeddedResource Include="Scene/prefab.xsd" LogicalName="Scene/prefab.xsd" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Apogee.Ecs.Tests" />
  </ItemGroup>
</Project>
