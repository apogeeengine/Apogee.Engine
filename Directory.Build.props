<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Company>Weft</Company>
    <Copyright>Copyright 2026 The Weft Authors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/weftengine/weft</RepositoryUrl>
    <BaseOutputPath>$(MSBuildThisFileDirectory)Bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)Bin/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!--
    A NativeAOT program is compiled for a fixed instruction set (the JIT asks the CPU when the program starts; ahead-of-time code cannot), and a CPU without it does
    not start the game. The default of x64 is already x86-64-v2 (SSE4.2 and POPCNT: Vector128 at full speed, no AVX2, so Vector256.IsHardwareAccelerated is false); it is
    written down here so that it is a decision. -p:WeftAotInstructionSet=x86-64-v3 builds for AVX2 and FMA (Intel since 2013, AMD since 2015) at the price of the older CPUs. An
    Apple-silicon Mac is at least an M1, which adds atomics, CRC, rounding multiply and dot products. See Docs/manual/core/profiling.md.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <WeftAotArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</WeftAotArchitecture>
    <WeftAotArchitecture Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.EndsWith('-x64'))">X64</WeftAotArchitecture>
    <WeftAotArchitecture Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.EndsWith('-arm64'))">Arm64</WeftAotArchitecture>
    <WeftAotOperatingSystem>linux</WeftAotOperatingSystem>
    <WeftAotOperatingSystem Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</WeftAotOperatingSystem>
    <WeftAotOperatingSystem Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx-'))">osx</WeftAotOperatingSystem>
    <WeftAotOperatingSystem Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('osx-'))">other</WeftAotOperatingSystem>
    <WeftAotInstructionSet Condition="'$(WeftAotInstructionSet)' == '' and '$(WeftAotArchitecture)' == 'X64'">x86-64-v2</WeftAotInstructionSet>
    <WeftAotInstructionSet Condition="'$(WeftAotInstructionSet)' == '' and '$(WeftAotArchitecture)' == 'Arm64' and '$(WeftAotOperatingSystem)' == 'osx'">apple-m1</WeftAotInstructionSet>
    <IlcInstructionSet Condition="'$(IlcInstructionSet)' == ''">$(WeftAotInstructionSet)</IlcInstructionSet>
  </PropertyGroup>
</Project>
