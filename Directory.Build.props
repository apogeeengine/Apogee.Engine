<Project>
  <!-- The engine's version, written once (see the comment in it); everything below is derived from it. -->
  <Import Project="$(MSBuildThisFileDirectory)Engine.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Company>Weft</Company>
    <Copyright>Copyright $(WeftCopyrightYear) The Weft Authors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/weftengine/weft</RepositoryUrl>
    <BaseOutputPath>$(MSBuildThisFileDirectory)Bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)Bin/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!--
    The versions of every assembly, from Engine.props. WeftBuildNumber is the number of the CI run (WEFT_BUILD_NUMBER: github.run_number) and 0 on a developer's machine; it is the last part of
    FileVersion, which holds 16 bits, so a number above 65535 starts again from 0 there (EngineVersion.Build keeps the whole number). The informational version is Version plus the commit
    (+abc1234, from SourceRevisionId, set below): 0.2.0-alpha+abc1234. Nothing else sets a version: ./build.sh version check fails on a <Version> or <AssemblyVersion> anywhere else.
  -->
  <PropertyGroup>
    <WeftBuildNumber>$(WEFT_BUILD_NUMBER)</WeftBuildNumber>
    <WeftBuildNumber Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(WeftBuildNumber)', '^[0-9]{1,9}$'))">0</WeftBuildNumber>
    <WeftVersionCore>$(WeftVersionMajor).$(WeftVersionMinor).$(WeftVersionPatch)</WeftVersionCore>
    <WeftVersion>$(WeftVersionCore)-$(WeftVersionStatus)</WeftVersion>
    <WeftVersion Condition="'$(WeftVersionStatus)' == 'stable'">$(WeftVersionCore)</WeftVersion>
    <Version>$(WeftVersion)</Version>
    <AssemblyVersion>$(WeftVersionCore).0</AssemblyVersion>
    <FileVersion>$(WeftVersionCore).$([MSBuild]::Modulo($(WeftBuildNumber), 65536))</FileVersion>
  </PropertyGroup>

  <!-- The commit the build is of: the SDK appends SourceRevisionId to the informational version, and Weft.Core writes it into EngineVersion.Commit. Left empty outside a git checkout. -->
  <Target Name="WeftSourceRevision" BeforeTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short=7 HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_WeftGitExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_WeftGitOutput" />
    </Exec>
    <!-- Only a successful run's output is looked at: an error message could hold a quote, which would break the condition. -->
    <PropertyGroup Condition="'$(_WeftGitExitCode)' == '0'">
      <SourceRevisionId Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_WeftGitOutput)', '^[0-9a-f]{7,40}$'))">$(_WeftGitOutput)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!--
    A NativeAOT program is compiled for a fixed instruction set (the JIT asks the CPU when the program starts; ahead-of-time code cannot), and a CPU without it does
    not start the game. The default of x64 is already x86-64-v2 (SSE4.2 and POPCNT: Vector128 at full speed, no AVX2, so Vector256.IsHardwareAccelerated is false); it is
    written down here so that it is a decision. -p:WeftAotInstructionSet=x86-64-v3 builds for AVX2 and FMA (Intel since 2013, AMD since 2015) at the price of the older CPUs. An
    Apple-silicon Mac is at least an M1, which adds atomics, CRC, rounding multiply and dot products. See Docs/manual/core/profiling.md.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <WeftAotArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</WeftAotArchitecture>
    <WeftAotArchitecture Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.EndsWith('-x64'))">X64</WeftAotArchitecture>
    <WeftAotArchitecture Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.EndsWith('-arm64'))">Arm64</WeftAotArchitecture>
    <WeftAotOperatingSystem>linux</WeftAotOperatingSystem>
    <WeftAotOperatingSystem Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</WeftAotOperatingSystem>
    <WeftAotOperatingSystem Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx-'))">osx</WeftAotOperatingSystem>
    <WeftAotOperatingSystem Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('osx-'))">other</WeftAotOperatingSystem>
    <WeftAotInstructionSet Condition="'$(WeftAotInstructionSet)' == '' and '$(WeftAotArchitecture)' == 'X64'">x86-64-v2</WeftAotInstructionSet>
    <WeftAotInstructionSet Condition="'$(WeftAotInstructionSet)' == '' and '$(WeftAotArchitecture)' == 'Arm64' and '$(WeftAotOperatingSystem)' == 'osx'">apple-m1</WeftAotInstructionSet>
    <IlcInstructionSet Condition="'$(IlcInstructionSet)' == ''">$(WeftAotInstructionSet)</IlcInstructionSet>
  </PropertyGroup>
</Project>
