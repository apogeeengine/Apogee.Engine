{
  "name": "net",
  "project": "Source/Weft.Native.Net",
  "namespace": "Weft.Native.Net",
  "className": "Net",
  "library": {
    "name": "weft_net",
    "linux": ["libweft_net.so"],
    "windows": ["weft_net.dll"],
    "macos": ["libweft_net.dylib"]
  },
  // Our own C API over GameNetworkingSockets (Native/net/weft_net.h): connections as integers, everything GNS says as events from a poll.
  "includeDirs": ["Native/net"],
  "includes": ["weft_net.h"],
  "ownDirs": ["Native/net"],
  "stripPrefixes": ["an_", "AN_"],
  "excludeConstants": ["^WEFT_NET_H$"]
}
