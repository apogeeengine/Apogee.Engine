<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AnalysisMode>Default</AnalysisMode>
    <!-- CA1051: the fields of a component struct are public by design. CA1822, CA2211: the fixture classes are instances with
         members that happen not to use their state, and a counter the tests read. -->
    <NoWarn>$(NoWarn);CA1051;CA1822;CA2211</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Source/Apogee.Scripting/Apogee.Scripting.csproj" />
    <ProjectReference Include="../../Source/Apogee.Reflection.Generator/Apogee.Reflection.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot" />
    <Compile Include="../Apogee.Native.Tests/NativeRequirements.cs" Link="NativeRequirements.cs" />
  </ItemGroup>
  <Import Project="../../ThirdParty/NativeLibraries.props" />
</Project>
