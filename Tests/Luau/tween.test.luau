--!strict
-- The tween library, on the runner's clock: every frame of a case is 1/60 s of game time and of real time.
local test = require("@engine/test")

test.describe("tween", function()
	test.it("value calls its setter each step and ends exactly on the target", function()
		local seen: { number } = {}
		tween.value(0, 10, 1, function(v: number)
			table.insert(seen, v)
		end)
		test.expect(#seen).toBe(0)
		test.frames(30)
		test.expect(#seen).toBe(30)
		test.expect(seen[30]).toBeNear(5, 1e-6)
		test.frames(30)
		test.expect(#seen).toBe(60)
		test.expect(seen[60]).toBe(10)
		test.frames(10)
		test.expect(#seen).toBe(60)
	end)

	test.it("value moves vectors and colours", function()
		local last = Vector3(0, 0, 0)
		tween.value(Vector3(1, 0, 0), Vector3(0, 0, 1), 0.5, function(c: vector)
			last = c
		end)
		test.frames(15)
		test.expect(last.x).toBeNear(0.5, 1e-5)
		test.expect(last.z).toBeNear(0.5, 1e-5)
		test.frames(15)
		test.expect(last).toBe(Vector3(0, 0, 1))
	end)

	test.it("value slerps rotations", function()
		local target = Quat.axisAngle(Vector3(0, 1, 0), math.pi / 2)
		local last = Quat.identity
		tween.value(Quat.identity, target, 1, function(q: Quat)
			last = q
		end)
		test.frames(30)
		test.expect(last:dot(Quat.axisAngle(Vector3(0, 1, 0), math.pi / 4))).toBeNear(1, 1e-5)
		test.frames(30)
		test.expect(last == target).toBe(true)
	end)

	test.it("ease evaluates the curves", function()
		test.expect(tween.ease("linear", 0.3)).toBeNear(0.3, 1e-9)
		test.expect(tween.ease("quad_in", 0.5)).toBeNear(0.25, 1e-9)
		test.expect(tween.ease("cubic_out", 0.5)).toBeNear(0.875, 1e-9)
		test.expect(tween.ease("bounce_in_out", 0)).toBe(0)
		test.expect(tween.ease("elastic_in_out", 1)).toBe(1)
		test.expect(tween.ease("back_out", 0.8)).toBeNear(1.0 + 2.70158 * (-0.2) ^ 3 + 1.70158 * 0.04, 1e-9)
		test.expect(tween.ease("quad_in", 5)).toBe(1)
		test.expect(function()
			tween.ease("wobble", 0.5)
		end).toThrow("is not an ease")
	end)

	test.it("options give a delay, an ease and repeats that reverse", function()
		local seen: { number } = {}
		local handle = tween.value(0, 1, 0.25, function(v: number)
			table.insert(seen, v)
		end, { delay = 0.25, repeats = 1, reverses = true, ease = "quad_in" })
		local done = false
		handle.completed:connect(function()
			done = true
		end)
		test.frames(14)
		test.expect(#seen).toBe(0)
		test.frames(1) -- the delay ends and the start value is written
		test.expect(seen[1]).toBe(0)
		test.frames(14) -- the end of the first pass
		test.frames(15)
		test.expect(done).toBe(false)
		test.frames(1)
		test.expect(done).toBe(true)
		test.expect(seen[#seen]).toBe(0) -- two passes, the second backwards: it ends where it began
	end)

	test.it("a handle pauses, resumes, cancels and completes", function()
		local value = 0
		local handle = tween.value(0, 10, 1, function(v: number)
			value = v
		end)
		local events: { string } = {}
		handle.completed:connect(function()
			table.insert(events, "completed")
		end)
		handle.cancelled:connect(function()
			table.insert(events, "cancelled")
		end)

		test.frames(15)
		test.expect(handle.playing).toBe(true)
		handle:pause()
		test.expect(handle.paused).toBe(true)
		test.expect(handle.playing).toBe(false)
		local held = value
		test.frames(30)
		test.expect(value).toBe(held)
		handle:resume()
		test.frames(15)
		test.expect(value).toBeNear(5, 1e-6)
		test.expect(handle.progress).toBeNear(0.5, 1e-6)

		handle:complete()
		test.expect(value).toBe(10)
		test.expect(handle.playing).toBe(false)
		handle:cancel() -- over: nothing happens
		test.expect(events).toEqual({ "completed" })

		local other = tween.value(0, 10, 1, function(v: number)
			value = v
		end)
		other.cancelled:connect(function()
			table.insert(events, "other cancelled")
		end)
		test.frames(10)
		other:cancel()
		local stopped = value
		test.frames(30)
		test.expect(value).toBe(stopped)
		test.expect(events).toEqual({ "completed", "other cancelled" })
	end)

	test.it("a tween plays on when the script drops the handle", function()
		local value = 0
		tween.value(0, 1, 0.5, function(v: number)
			value = v
		end)
		test.frames(30)
		test.expect(value).toBe(1)
	end)

	test.it("wait yields a task until the tween ends", function()
		local log: { string } = {}
		task.spawn(function()
			local first = tween.value(0, 1, 0.25, function() end)
			table.insert(log, tostring(first:wait()))
			local second = tween.value(0, 1, 10, function() end)
			task.delay(0.1, function()
				second:cancel()
			end)
			table.insert(log, tostring(second:wait()))
			table.insert(log, tostring(first:wait())) -- over already
		end)
		test.frames(14)
		test.expect(#log).toBe(0)
		test.frames(1)
		test.expect(log).toEqual({ "true" })
		test.frames(6)
		test.expect(log).toEqual({ "true", "false", "true" })
	end)

	test.it("wait outside a task is an error", function()
		local handle = tween.value(0, 1, 1, function() end)
		test.expect(function()
			handle:wait()
		end).toThrow("must run in a task")
		handle:cancel()
	end)

	test.it("unscaled tweens use the real clock", function()
		local value = 0
		tween.value(0, 1, 0.5, function(v: number)
			value = v
		end, { unscaled = true })
		test.frames(15)
		test.expect(value).toBeNear(0.5, 1e-6)
	end)

	test.it("mixed or wrong types are errors", function()
		test.expect(function()
			tween.value(1, Vector3(1, 2, 3), 1, function() end)
		end).toThrow("like 'from'")
		test.expect(function()
			tween.value("a", "b", 1, function() end)
		end).toThrow("number, vector or Quat expected")
		test.expect(function()
			tween.value(1, 2, 1, function() end, { speed = 3 })
		end).toThrow("is not an option")
		test.expect(function()
			tween.value(1, 2, 1, function() end, { ease = "wobble" })
		end).toThrow("is not an ease")
	end)

	test.it("field animates a component in place", function()
		local world = test.world()
		local Position = world:component("Position", { x = "f32", count = "i32" })
		local entity = world:create_entity()
		world:set(entity, Position, { x = 0, count = 0 })
		local moving = tween.field(world, entity, Position, "x", 10, 1)
		tween.field(world, entity, Position, "count", 20, 1, { ease = "quad_in" })
		test.frames(30)
		test.expect(world:get(entity, Position).x).toBeNear(5, 1e-4)
		test.expect(world:get(entity, Position).count).toBe(5)
		test.frames(30)
		test.expect(world:get(entity, Position).x).toBe(10)
		test.expect(world:get(entity, Position).count).toBe(20)
		test.expect(moving.playing).toBe(false)
	end)

	test.it("field is cancelled when the entity dies", function()
		local world = test.world()
		local Position = world:component("Position", { x = "f32" })
		local entity = world:create_entity()
		world:set(entity, Position, { x = 0 })
		local handle = tween.field(world, entity, Position, "x", 10, 1)
		local cancelled = false
		handle.cancelled:connect(function()
			cancelled = true
		end)
		test.frames(5)
		world:destroy(entity)
		test.frames(1)
		test.expect(cancelled).toBe(true)
		test.expect(handle.playing).toBe(false)
	end)

	test.it("field rejects what it cannot animate", function()
		local world = test.world()
		local Flags = world:component("Flags", { on = "bool", x = "f32" })
		local entity = world:create_entity()
		world:set(entity, Flags, { on = true, x = 0 })
		test.expect(function()
			tween.field(world, entity, Flags, "on", 1, 1)
		end).toThrow("only numbers")
		test.expect(function()
			tween.field(world, entity, Flags, "nope", 1, 1)
		end).toThrow("is not a field")
		test.expect(function()
			tween.field(world, entity, Flags, "x", Vector3(1, 2, 3), 1)
		end).toThrow("number expected")
	end)
end)
